#!/bin/sh
# Installed in place of Playwright's chrome-headless-shell (PDF export): memory check,
# then Chromium with small-memory flags (one renderer, no GPU process, small V8 heap).
# CHROMIUM_EXTRA_FLAGS replaces these flags if you need different ones.
. /usr/local/lib/resume-matcher-railway/pdf-memcheck.sh
exec "$(dirname "$0")/chrome-headless-shell.real" \
  ${CHROMIUM_EXTRA_FLAGS:---disable-gpu --disable-dev-shm-usage --renderer-process-limit=1 --disable-features=site-per-process --js-flags=--max-old-space-size=64} "$@"
